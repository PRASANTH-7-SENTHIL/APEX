# APEX INFRASTRUCTURE - Environment Configuration
# Copy this file to .env and fill in your values

# Server port (default: 3000)
PORT=3000

# Google Sheets Webhook URL
# Set up a Google Apps Script Web App that accepts POST requests and appends to your sheet.
# Deploy the Apps Script as a web app and paste the URL below:
GOOGLE_SHEETS_WEBHOOK_URL=

# Admin key to protect GET /api/quotes endpoint (optional)
ADMIN_KEY=your-secret-admin-key-here
